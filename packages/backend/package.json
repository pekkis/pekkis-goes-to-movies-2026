{
  "name": "@pgtm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL storage for showtimes: migrations, ingest and the HTTP API",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "ingest": "node --env-file-if-exists=../../.env src/cli/ingest.ts",
    "showtimes": "node --env-file-if-exists=../../.env src/cli/showtimes.ts",
    "db:types": "node --env-file-if-exists=../../.env src/cli/db-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "api:dev": "node --env-file-if-exists=../../.env --watch src/cli/serve.ts",
    "build": "tsdown"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.7",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pgtm/model": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.19",
    "hono": "^4.13.18",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsdown": "^0.23.7"
  },
  "engines": {
    "node": ">=26"
  }
}
