{
  "name": "@pgtm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL storage for showtimes: migrations, ingest, and later the API",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "ingest": "node --env-file-if-exists=../../.env src/cli/ingest.ts",
    "showtimes": "node --env-file-if-exists=../../.env src/cli/showtimes.ts",
    "db:types": "node --env-file-if-exists=../../.env src/cli/db-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@pgtm/model": "workspace:*",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
