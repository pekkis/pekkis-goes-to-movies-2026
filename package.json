{
  "name": "pekkis-goes-to-movies",
  "version": "0.1.0",
  "private": true,
  "description": "All Finnish cinema showtimes on one site",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "pull": "pnpm --filter @pgtm/fetcher pull",
    "match": "pnpm --filter @pgtm/fetcher match",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U pgtm -d pgtm",
    "migrate": "pnpm --filter @pgtm/backend migrate",
    "db:types": "pnpm --filter @pgtm/backend db:types",
    "ingest": "pnpm --filter @pgtm/backend ingest",
    "data:push": "node --env-file-if-exists=.env scripts/push-data.ts",
    "showtimes": "pnpm --filter @pgtm/backend showtimes",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm web:build && pnpm test",
    "vendor:leffavuoro": "node scripts/vendor-leffavuoro.ts",
    "design:render": "node scripts/render-diagrams.ts && node scripts/render-journey-maps.ts",
    "venues:locate": "pnpm --filter @pgtm/fetcher venues:locate",
    "api:dev": "pnpm --filter @pgtm/backend api:dev",
    "api:up": "docker compose --profile app up -d --build --wait",
    "api:down": "docker compose --profile app rm --stop --force api migrate",
    "web:dev": "pnpm --filter @pgtm/web-front dev",
    "web:build": "pnpm --filter @pgtm/web-front build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mermaid": "^12.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0"
}
