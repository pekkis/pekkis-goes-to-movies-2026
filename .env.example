# TMDB API Read Access Token (v4, starts with "eyJ"): https://www.themoviedb.org/settings/api
TMDB_APIKEY=
# Optional: OMDb API key for Rotten Tomatoes, Metacritic and IMDb scores: https://www.omdbapi.com/apikey.aspx
OMDB_APIKEY=
# Optional: URL or email added to the User-Agent so cinemas can reach you
CONTACT=
# PostgreSQL from compose.yaml (`pnpm db:up`)
DATABASE_URL=postgres://pgtm:pgtm@localhost:5432/pgtm
TEST_DATABASE_URL=postgres://pgtm:pgtm@localhost:5432/pgtm_test
# Optional: turns on the MCP endpoint /mcp/{MCP_TOKEN} for chatbots (24+ random characters)
MCP_TOKEN=
# Production server (pnpm data:push): user@host:/path/of/the/server/checkout
DEPLOY_TARGET=
# Server only: Postgres password (set before the first `up`), local ports for nginx
POSTGRES_PASSWORD=
API_PORT=
WEB_PORT=
# Server only: the website's public address, e.g. https://elokuvat.example
SITE_URL=
