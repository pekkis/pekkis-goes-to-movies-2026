{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "vendor/**",
    "apps/fpgm/**",
    "apps/web-front/.astro/**",
    "apps/web-front/dist/**"
  ],
  "overrides": [
    {
      "files": ["**/test/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
