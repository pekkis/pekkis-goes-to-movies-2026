---
import { programmeToday } from "@pgtm/model/time";
import { FilmGrid } from "../../components/FilmGrid.tsx";
import Base from "../../layouts/Base.astro";
import { listVenues } from "../../lib/api.ts";
import { citiesOf } from "../../lib/cities.ts";
import { loadFrontPage } from "../../lib/film-pages.ts";
import { fi } from "../../lib/text.ts";
import { sprinkles } from "../../styles/sprinkles.css.ts";

const [venues, films] = await Promise.all([
  listVenues(Astro.locals.api),
  loadFrontPage(Astro.locals.api, programmeToday(Astro.locals.now)),
]);
const cities = citiesOf(venues);
---

<Base title={fi.siteName}>
  <p class={sprinkles({ marginBottom: "md" })}>{fi.tagline}</p>
  <p class={sprinkles({ marginBottom: "lg" })}><a href="/fi/haku">{fi.searchTitle} →</a></p>

  <h1 class={sprinkles({ marginBottom: "sm" })}>{fi.newFilms}</h1>
  <p class={sprinkles({ marginBottom: "md" })}>{fi.newFilmsIntro}</p>
  <h2 class={sprinkles({ marginBottom: "sm" })}>{fi.openedThisWeek}</h2>
  {films.opened.length ? <FilmGrid openings={films.opened} /> : <p class={sprinkles({ marginBottom: "lg" })}>{fi.noNewFilms}</p>}
  <h2 class={sprinkles({ marginBottom: "sm" })}>{fi.comingThisWeek}</h2>
  {films.coming.length ? <FilmGrid openings={films.coming} /> : <p class={sprinkles({ marginBottom: "lg" })}>{fi.noNewFilms}</p>}

  <h2 class={sprinkles({ marginBottom: "md" })}>{fi.cities}</h2>
  <ul role="list" class={sprinkles({ display: "flex", flexWrap: "wrap", gap: "sm" })}>
    {cities.map((c) => <li><a href={`/fi/kaupungit/${c.slug}`}>{c.name}</a></li>)}
  </ul>
</Base>
