# Ignore file for apps/web-front/Dockerfile (BuildKit reads <Dockerfile>.dockerignore):
# the root one, minus its exclusion of the website's sources.
# Keep the build context small and free of secrets and data.
**/node_modules
**/dist
data/
vendor/
.env
.env.*
.git/
docs/
**/test/
packages/fetcher/*
!packages/fetcher/package.json
apps/fpgm/
apps/web-front/.astro/
